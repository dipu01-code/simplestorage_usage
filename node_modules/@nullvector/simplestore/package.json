{
  "name": "@nullvector/simplestore",
  "version": "1.0.0",
  "description": "Beginner-friendly, cross-platform local storage abstraction for Web and React Native",
  "author": "Dipu",
  "license": "MIT",
  "homepage": "https://github.com/dipu01-code/npm_package-project#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipu01-code/npm_package-project.git"
  },
  "keywords": [
    "storage",
    "localstorage",
    "async-storage",
    "react-native",
    "expo",
    "web",
    "key-value",
    "typescript",
    "simplestore"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      },
      "require": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native.d.mts",
        "default": "./dist/react-native.mjs"
      },
      "require": {
        "types": "./dist/react-native.d.ts",
        "default": "./dist/react-native.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
